{
  "name": "@rootnative/devhub-web",
  "version": "0.0.0",
  "private": true,
  "description": "The page of devhub ui. The build of @rootnative/devhub copies its web export into dist/ui/.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "clean": "node -e \"for (const p of ['dist', '.expo', '.turbo']) require('node:fs').rmSync(p, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@rootnative/components": "0.0.0-alpha.27",
    "@rootnative/core": "0.0.0-alpha.27",
    "@rootnative/inertia": "0.0.19",
    "expo": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
