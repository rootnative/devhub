{
  "name": "@rootnative/devhub-web",
  "version": "0.0.0",
  "private": true,
  "description": "The page of devhub ui. The build of @rootnative/devhub copies its web export into dist/ui/.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "clean": "node -e \"for (const p of ['dist', '.expo', '.turbo']) require('node:fs').rmSync(p, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@rootnative/components": "0.0.0-alpha.32",
    "@rootnative/core": "0.0.0-alpha.32",
    "@rootnative/icons": "0.0.0-alpha.32",
    "@rootnative/inertia": "0.0.24",
    "expo": "~58.0.17",
    "lucide-react-native": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
