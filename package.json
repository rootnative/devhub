{
  "name": "devhub-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for DevHub by Root Native (@rootnative/devhub): keep every Expo development build, and launch any one in one click.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json}\"",
    "clean": "turbo run clean",
    "docs:dev": "pnpm --filter @rootnative/devhub-docs dev",
    "docs:build": "turbo run build --filter=@rootnative/devhub-docs",
    "docs:check": "pnpm --filter @rootnative/devhub-docs build:check",
    "docs:serve": "pnpm --filter @rootnative/devhub-docs serve",
    "build:brand": "node scripts/build-brand.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "check:llms": "node scripts/build-llms.mjs --check",
    "check:artifact": "node scripts/check-artifact.mjs",
    "preflight": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:llms && pnpm run check:artifact"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^14.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
