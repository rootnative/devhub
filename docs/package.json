{
  "name": "@rootnative/devhub-docs",
  "version": "0.0.0",
  "private": true,
  "description": "The public docs site of DevHub by Root Native, at https://rootnative.github.io/devhub/.",
  "scripts": {
    "dev": "docusaurus start",
    "build": "docusaurus build",
    "build:check": "docusaurus build --out-dir .docusaurus/check-build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "serve": "docusaurus serve",
    "clean": "node -e \"for (const p of ['build', '.docusaurus', '.turbo']) require('node:fs').rmSync(p, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/preset-classic": "^3.10.0",
    "@easyops-cn/docusaurus-search-local": "^0.55.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/tsconfig": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "typescript": "^5.9.3"
  }
}
